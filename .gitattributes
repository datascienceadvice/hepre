# Нормализация переводов строк: в репозитории — LF, кроме Windows-скриптов.
* text=auto eol=lf

# PowerShell-скрипты должны иметь CRLF (Windows PowerShell 5.1 и часть инструментов
# некорректно читают LF-файлы с BOM-less заголовком).
*.ps1 text eol=crlf

# Патчи и бинарные артефакты не нормализуем и не показываем как diff.
*.patch -text
*.bin -text -diff

# Генерируемые результаты исследования — не считать их «написанным» кодом.
results/** linguist-generated=true
