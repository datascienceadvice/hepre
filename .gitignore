# --- Rust build artifacts ---
/target/
**/*.rs.bk
*.pdb

# --- Cargo ---
# Cargo.lock is intentionally committed (application-style crate with examples/bin).

# --- Vendored OpenFHE (sources + builds) ---
# vendor/ содержит форк OpenFHE `openfhe-development` и его билды/префиксы —
# это тяжёлые внешние артефакты, в репозиторий не входят.
/vendor/

# --- Handoff-файлы демо-утилит ролей (генерируются src/bin/{lab,server,hospital}) ---
/handoff/

# --- Результаты исследования ---
# results/ СОЗНАТЕЛЬНО отслеживается: это замороженные артефакты
# воспроизведения, на которые ссылается статья. Удалённые прогоны можно
# чистить вручную.

# --- Рукопись статьи (НЕ публикуется) ---
# Черновик статьи — фрагмент докторской диссертации. Он намеренно исключён
# из репозитория: до подачи в журнал текст не должен быть публично доступен,
# а решение о раскрытии принимает автор. Каталог paper/ содержит рукопись,
# рисунки и таблицы, сгенерированные из results/.
/paper/

# --- C/C++ / clang-cl / CMake artifacts ---
*.obj
*.o
*.lib
*.a
*.dll
*.so
*.exe
*.out
*.pdb
*.ilk
*.idb
/out/
/cmake-build-*/

# --- RStudio project cruft (hepre.Rproj сам отслеживается) ---
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# --- Editor / OS ---
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db